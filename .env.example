# Copy to .env for local dev. Vite only embeds vars prefixed with VITE_.

# Local backend during development:
VITE_API_URL=http://localhost:8000

# When deploying to Netlify, set this build environment variable instead to
# your live Render URL, e.g. https://shopping-list-api.onrender.com

# OneSignal App ID (public, not a secret) from the OneSignal dashboard ->
# Settings -> Keys & IDs. Leave unset to disable push. Set it on Netlify too.
# VITE_ONESIGNAL_APP_ID=
